{
  "name": "serviceassistant",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "build:shared": "yarn --cwd ../shared build",
    "predev": "yarn build:shared",
    "prebuild": "yarn build:shared",
    "pretypecheck": "yarn build:shared",
    "dev": "vite",
    "build": "tsc && vite build && yarn copybuild",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "copybuild": "node copybuild"
  },
  "dependencies": {
    "@shared": "file:../shared",
    "@sk-web-gui/ai": "^4.7.0",
    "@sk-web-gui/core": "^4.6.2",
    "@sk-web-gui/react": "^3.1.3",
    "dayjs": "^1.11.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-html-parser": "^2.0.2",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-html-parser": "^2.0.7",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "copy-file": "^11.1.0",
    "cssnano": "^8.0.7",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
